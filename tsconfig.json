{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ],
    "paths": {
      "@contracts/*": [
        "./packages/contracts/src/*"
      ]
    }
  },
  "files": [
    "apps/web/src/main.tsx",
    "apps/web/src/vite-env.d.ts",
    "apps/web/src/ui/elements.d.ts",
    "apps/gateway/src/main.ts",
    "apps/gateway/src/runtime.ts",
    "apps/gateway/test/firestore-store.test.ts",
    "apps/gateway/test/workflow.test.ts",
    "apps/gateway/test/agent-tasks.test.ts",
    "apps/gateway/test/approval-review.test.ts",
    "apps/gateway/test/mobility.test.ts",
    "apps/gateway/test/my-aide.test.ts",
    "apps/gateway/test/maps-mcp.test.ts",
    "apps/gateway/test/mobility-client.test.ts",
    "apps/gateway/test/analysis.test.ts",
    "apps/gateway/test/cloud-run.test.ts",
    "apps/gateway/test/configuration.test.ts",
    "apps/gateway/test/credentials.test.ts",
    "apps/gateway/test/evaluation.test.ts",
    "apps/gateway/test/hosted.test.ts",
    "apps/gateway/test/inspection.test.ts",
    "apps/gateway/test/mobile.test.ts",
    "apps/gateway/test/notification-delivery.test.ts",
    "apps/gateway/test/rehearsal.test.ts",
    "apps/gateway/test/notification-store.test.ts",
    "apps/gateway/test/observations.test.ts",
    "apps/gateway/test/overview.test.ts",
    "apps/gateway/test/telemetry.test.ts",
    "apps/gateway/test/web-client.test.ts",
    "tests/support/web-harness.tsx",
    "tests/support/mobility-harness.tsx",
    "scripts/check-android-core.ts",
    "scripts/generate-design-tokens.ts",
    "scripts/generate-mobile-fixtures.ts",
    "scripts/provision-gcp-membership.ts",
    "scripts/prepare-gcp-evaluation.ts",
    "tests/browser/workflow.mjs",
    "tests/browser/hosted.mjs",
    "apps/web/src/mobility/GroundedText.tsx",
    "apps/gateway/test/mobility-call-safety.test.ts",
    "tests/support/call-uncertainty-harness.tsx"
  ]
}
